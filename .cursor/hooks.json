{
  "version": 1,
  "hooks": {
    "afterFileEdit": [
      {
        "command": ".cursor/hooks/mark-ai-edit.sh",
        "timeout": 15
      }
    ],
    "afterTabFileEdit": [
      {
        "command": ".cursor/hooks/mark-ai-edit.sh",
        "timeout": 15
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/auto-commit-on-stop.sh",
        "timeout": 60
      }
    ]
  }
}
